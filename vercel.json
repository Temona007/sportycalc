{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path+/index.html",
      "destination": "/:path+/",
      "permanent": true
    },
    {
      "source": "/:path+/index.php",
      "destination": "/:path+/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{"type": "host", "value": "www.sportycalc.com"}],
      "destination": "https://sportycalc.com/$1",
      "permanent": true
    }
  ]
}
